{
  "name": "@fringeworks/react-layouts-adornment",
  "version": "0.3.2",
  "private": true,
  "description": "React HOCs for placing labels, badges, and other adornments around or over a main element with CSS",
  "keywords": [
    "react",
    "layout",
    "style"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/react-layouts-adornment.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./*.scss": "./src/css/*.scss",
    "./*.css": "./src/css/*.scss",
    "./with-css": "./src/with-css/index.ts",
    "./with-css/*": "./src/with-css/*/index.ts",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "dependencies": {
    "@fringeworks/react-style-proxy": "^0.9.3",
    "@fringeworks/react-utils": "^0.13.0",
    "@fringeworks/style-layouts-adornment": "^0.4.2",
    "@fringeworks/types": "^1.2.0",
    "@fringeworks/utils": "^2.3.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@chromatic-com/storybook": "^5.6.0",
    "@fringeworks/dev": "^0.13.4",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/react": "^16.3.3",
    "@tsdown/css": "^0.23.7",
    "@types/babel__core": "^7.20.5",
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "chroma-js": "^3.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "^10.6.7",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "sass-embedded": "^1.108.2",
    "storybook": "^10.6.7",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
